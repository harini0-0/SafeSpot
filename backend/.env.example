# Safe Spot backend — environment variables.
# Copy this file to `.env` (which is git-ignored) and fill in the values.
# Never commit real keys.

# --- Matterport Model API (used by scripts/fetch_model.py to pull house data) ---
# Token ID (username) and Token Secret (password) from the CoStar/Matterport workshop.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

# --- AWS Bedrock (damage agent + voice Q&A agent) ---
# Ask the Amazon sponsor for credentials. Region and model must be enabled in
# the Bedrock console for that account (see open questions in CLAUDE.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# A Bedrock model id enabled in AWS_REGION above (leave blank until confirmed).
BEDROCK_MODEL_ID=
